{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slot-spec-capture/spec.schema.json",
  "title": "Slot raw spec (v0.2, draft)",
  "description": "Raw observations of one slot game. Core fields are fixed; anything else goes to features[]. Every value is a Field: {value, source, confidence, ref?, note?}. Unknown stays {\"value\": null, \"source\": \"unknown\"}.",
  "type": "object",
  "required": [
    "schemaVersion",
    "game",
    "capturedAt",
    "core",
    "features"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "game": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Path slug from the URL. Never the query string."
        },
        "title": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        }
      }
    },
    "capturedAt": {
      "type": "string",
      "format": "date"
    },
    "core": {
      "type": "object",
      "properties": {
        "grid": {
          "$ref": "#/$defs/field",
          "description": "{cols, rows}; or {cols, rowsPerReel[]} when reels differ"
        },
        "payModel": {
          "$ref": "#/$defs/field",
          "description": "lines | ways | cluster | scatterPay | other"
        },
        "waysOrLines": {
          "$ref": "#/$defs/field"
        },
        "payDirection": {
          "$ref": "#/$defs/field",
          "description": "leftToRight | bothWays | anywhere"
        },
        "minMatch": {
          "$ref": "#/$defs/field"
        },
        "spinMode": {
          "$ref": "#/$defs/field",
          "description": "spin | drop"
        },
        "dropMode": {
          "$ref": "#/$defs/field",
          "description": "whole | perReel | perCell | none"
        },
        "cascade": {
          "$ref": "#/$defs/field",
          "description": "{enabled, refill: inPlace|fromTop}"
        },
        "freeGame": {
          "$ref": "#/$defs/field",
          "description": "{trigger, initialSpins, retrigger, multiplier}. Trigger show and one free spin go in presentation.timelines when a free game actually starts."
        },
        "buyFeature": {
          "$ref": "#/$defs/field",
          "description": "{available, costX, target, options?}. options[] when several packages exist: {name, costX, target}. Read the panel; do not confirm a purchase."
        },
        "wild": {
          "$ref": "#/$defs/field",
          "description": "{substitutesExcept[], reels[]}"
        },
        "scatter": {
          "$ref": "#/$defs/field"
        },
        "paytable": {
          "$ref": "#/$defs/field",
          "description": "{symbolId: {count: payX}}"
        },
        "rtp": {
          "$ref": "#/$defs/field"
        },
        "maxWin": {
          "$ref": "#/$defs/field"
        },
        "betRange": {
          "$ref": "#/$defs/field"
        },
        "jackpot": {
          "$ref": "#/$defs/field"
        },
        "lines": {
          "$ref": "#/$defs/field",
          "description": "[{line, rows[]}] rows = row index per reel, 0 = top; plus multiplierReelOnLines"
        },
        "symbols": {
          "$ref": "#/$defs/field",
          "description": "[{name, role: wild|scatter|normal|multiplier, pay3/pay4/pay5}] one row per symbol, from the rules and the screen"
        },
        "extraBet": {
          "$ref": "#/$defs/field",
          "description": "{costX, payBasis, effect}"
        },
        "multiplierReel": {
          "$ref": "#/$defs/field",
          "description": "{values[], applies: line|totalWin, freeGameDifferent}"
        },
        "split": {
          "$ref": "#/$defs/field",
          "description": "{perCell[], lineFactor, formula}"
        },
        "volatility": {
          "$ref": "#/$defs/field"
        }
      }
    },
    "features": {
      "type": "array",
      "description": "Special mechanics. Name them as the rules page does.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "during",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "during": {
            "enum": [
              "base",
              "free",
              "both",
              "buy"
            ]
          },
          "trigger": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "description": "Player-facing feel. No node names.",
      "properties": {
        "measured": {
          "type": "object",
          "description": "Written by probe/reels.js: cell{heightPx,design,columns}, speedModes[{mode,startGapMs,scrollCellsPerSec,stopGapMs,decelMs,bounce:\"none\"|{cells,ms}|null,firstStopMs,lastStopMs}], quickStop[{mode,tapToAllStoppedMs,firstToLastReelMs,bounce}], anticipation:\"notSeen\"|[{mode,reel,extraWaitMs,slowCellsPerSec}], winSequence[{reelsStoppedMs,specialMs,lineMs,winShownMs,winCountMs,balanceRollMs,readyMs,bigWin,winX}]. null = not measurable, \"none\" = observed absent."
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "topic",
              "kind",
              "text"
            ],
            "properties": {
              "topic": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "observed",
                  "inferred"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "bigWinRules": {
          "description": "Big-win tiers from rules, or null"
        }
      }
    },
    "ui": {
      "type": "object",
      "description": "Controls seen: autoplay options, turbo, feature menu, etc."
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "source": {
      "enum": [
        "rules",
        "observed",
        "clientConfig",
        "inferred",
        "unknown"
      ]
    },
    "field": {
      "type": "object",
      "required": [
        "value",
        "source"
      ],
      "properties": {
        "value": {},
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "ref": {
          "type": "string",
          "description": "Quote or line in rules.txt"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
